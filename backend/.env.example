# ============================================================
# MineSafe Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed browser origins.
# LOCAL:      http://localhost:3000,http://localhost:5173
# PRODUCTION: Add your Vercel frontend URL below
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-minesafe-app.vercel.app

# ─── OPERATIONAL MODE ────────────────────────────────────────
# OPERATION_MODE: 'SIMULATION' or 'HARDWARE'
# HARDWARE_ENABLED: Set to 'false' in cloud (no COM port access on Railway/Render)
OPERATION_MODE=SIMULATION
HARDWARE_ENABLED=false

# ─── CLOUD DATABASE (Supabase) ───────────────────────────────
# Get from: Supabase Dashboard > Project Settings > API
# NOTE: This is a Vite + Node.js project — do NOT use @supabase/ssr or NEXT_PUBLIC_* keys.
# The frontend never connects to Supabase directly; it talks to this Node.js backend only.
# SUPABASE_PUBLISHABLE_KEY is Supabase's new dashboard label for the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── ESP32 SERIAL (LOCAL HARDWARE ONLY) ──────────────────────
# Leave empty in cloud deployments (HARDWARE_ENABLED=false above disables serial).
# The backend connects ONLY to ESP32 #2 (RECEIVER/GATEWAY) over USB Serial.
# ESP32 #1 (SENSOR_NODE) communicates wirelessly via ESP-NOW, never via USB.
#
# Data path:
#   ESP32 SENSOR_NODE (MPU6500 + HC-SR04)
#       ↓  ESP-NOW (wireless)
#   ESP32 RECEIVER/GATEWAY
#       ↓  USB Serial (Windows COMx)
#   Node.js backend (hardware.js)
#
SERIAL_PORT=
SERIAL_BAUD_RATE=115200
SERIAL_AUTO_RECONNECT=true
SERIAL_RECONNECT_INTERVAL_MS=5000

# Logical identifiers for the two-node ESP32 topology
GATEWAY_ID=ESP32_RX_01
SENSOR_NODE_ID=ESP32_SENSOR_01

# ─── WEATHER API ─────────────────────────────────────────────
# Bailadila Deposit 14, Kirandul Mine coordinates (Open-Meteo, no key required)
MINE_LATITUDE=18.6312
MINE_LONGITUDE=81.2485
WEATHER_UPDATE_INTERVAL_MS=600000
WEATHER_CACHE_TTL_MS=900000

# ─── ML SERVICE (FastAPI on Render) ──────────────────────────
# LOCAL:      http://localhost:8000/predict
# PRODUCTION: Set to your Render ML service URL after deploying ml-service/
ML_ENABLED=true
ML_SERVICE_URL=https://your-minesafe-ml.onrender.com/predict
ML_TIMEOUT_MS=800

# ─── DEFAULTS ────────────────────────────────────────────────
DEFAULT_SITE_ID=site-kirandul-01
DEFAULT_VEHICLE_ID=veh-d104
