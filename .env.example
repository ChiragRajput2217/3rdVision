# ============================================================
# 3rd Vision Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Google Maps Platform API Key
# Required for GoogleFleetMap interactive mining map integration
# Google Cloud Console APIs to enable:
# 1. Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── LOCAL DEVELOPMENT ───────────────────────────────────────
# Backend REST API & Socket.IO (local dev — backend runs on port 5000)
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# ─── PRODUCTION (Vercel frontend + Railway backend) ──────────
# Replace with your Railway backend URL after deploying backend/
VITE_API_BASE_URL=https://your-minesafe-backend.up.railway.app/api
VITE_SOCKET_URL=https://your-minesafe-backend.up.railway.app

# NOTE: Supabase credentials go in backend/.env ONLY.
# This is a Vite SPA — the frontend never calls Supabase directly.
# The frontend talks to the Node.js backend only.
# Do NOT add SUPABASE_* keys here.

# Demo / Auth mode (true = no real Firebase token required, email bypass active)
VITE_DEMO_MODE=true

# Firebase Configuration (optional — VITE_DEMO_MODE=true bypasses these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
